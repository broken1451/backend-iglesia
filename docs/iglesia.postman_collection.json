{
  "info": {
    "name": "API Iglesia",
    "description": "Todos los endpoints de la API Iglesia. 1) Ajusta baseUrl, email y password en Variables. 2) Ejecuta Auth → Login: el token se guarda solo. 3) Los \"Crear ...\" guardan el _id para usarlo en Ver/Editar/Desactivar. Documentación completa: docs/api.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3500/api"
    },
    {
      "key": "email",
      "value": "admin@iglesia.cl"
    },
    {
      "key": "password",
      "value": "cambia-esta-clave"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "iglesiaId",
      "value": ""
    },
    {
      "key": "actividadId",
      "value": ""
    },
    {
      "key": "noticiaId",
      "value": ""
    },
    {
      "key": "mensajeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Registro, login y gestión de usuarios. Ejecuta primero \"Login\": guarda el token para todos los demás requests.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", r.accessToken);",
                  "pm.test(\"login correcto\", () => pm.expect(r.accessToken).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con las variables email y password. Guarda el accessToken en la variable token. La respuesta trae el menú según el rol."
          }
        },
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const id = r.user?._id;",
                  "if (id) pm.collectionVariables.set(\"usuarioId\", id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"José\",\n  \"last_name\": \"Muñoz\",\n  \"email\": \"jose.munoz@iglesia.cl\",\n  \"password\": \"secreto123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea una cuenta con rol IGLESIA. No acepta roles. Guarda su _id en usuarioId."
          }
        },
        {
          "name": "Mi usuario (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Usuario dueño del token. Cualquier rol."
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Solo ADMIN."
          }
        },
        {
          "name": "Ver usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN."
          }
        },
        {
          "name": "Asignar roles",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"DISTRITO\",\n    \"COMUNICACIONES\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN. Reemplaza todos los roles."
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"nueva-clave-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN."
          }
        },
        {
          "name": "Desactivar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN. Sus tokens dejan de servir al instante."
          }
        },
        {
          "name": "Reactivar usuario",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN."
          }
        },
        {
          "name": "Desbloquear usuario",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unblock\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "{{usuarioId}}"
              ]
            },
            "description": "Solo ADMIN. Desbloquea una cuenta bloqueada por 3 intentos fallidos (retry vuelve a 0)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Iglesias",
