# Requests de la API Iglesia para la extensión REST Client de VS Code.
# Son los mismos de docs/iglesia.postman_collection.json, en el mismo orden.
# 1) Cambia @email y @password (un usuario ADMIN). 2) "Send Request" en Login. 3) Los demás usan su token.
# Los "Crear ..." y "Mensajes · Listar todos" tienen nombre: los Ver/Editar/Desactivar usan el _id que devolvieron.
# Documentación completa: docs/api.md

@baseUrl = http://localhost:3500/api
@email = admin@iglesia.cl
@password = cambia-esta-clave
@token = {{login.response.body.accessToken}}
@usuarioId = {{registrarUsuario.response.body.user._id}}
@iglesiaId = {{crearIglesia.response.body._id}}
@actividadId = {{crearActividad.response.body._id}}
@noticiaId = {{crearBorrador.response.body._id}}
@mensajeId = {{listarMensajes.response.body.$.data[0]._id}}

######## AUTH ########

### Auth · Login
# Inicia sesión con las variables email y password. Guarda el accessToken en la variable token. La respuesta trae el menú según el rol.
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### Auth · Mi usuario (me)
# Usuario dueño del token. Cualquier rol.
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


######## IGLESIAS ########

### Iglesias · Listar (sitio)
# Sin token: solo activas. Ordenadas por distrito y nombre.
GET {{baseUrl}}/iglesias?limit=20&offset=0


### Iglesias · Filtrar por distrito y nombre
# Público. distrito acepta el id ("araucania") o el nombre; search busca en el nombre o la comuna.
GET {{baseUrl}}/iglesias?distrito=araucania&search=temuco


### Iglesias · Buscar por comuna
# Público. search busca en el nombre y en la comuna, sin distinguir tildes ni mayúsculas.
GET {{baseUrl}}/iglesias?search=antofagasta


### Iglesias · Listar desactivadas (panel)
# Con token de ADMIN, DISTRITO o IGLESIA. Sin token se ignora isActive.
GET {{baseUrl}}/iglesias?isActive=false
Authorization: Bearer {{token}}


### Iglesias · Fichas incompletas (panel)
# Con token de ADMIN, DISTRITO o IGLESIA: solo las iglesias a las que les falta dirección, horario, pastor, correo o teléfono. Cada fila trae "ficha" ({ completos, total, porcentaje, completa, estado: "Faltan 5" }) y "pendientes". Sin token se ignora.
GET {{baseUrl}}/iglesias?pendientes=true
Authorization: Bearer {{token}}


### Iglesias · Fichas completas (panel)
# Con token de ADMIN, DISTRITO o IGLESIA: solo las iglesias con los 5 datos ("estado": "Completa").
GET {{baseUrl}}/iglesias?pendientes=false
Authorization: Bearer {{token}}


### Iglesias · Distritos
# Público. La lista fija de distritos, de norte a sur: { id, nombre, zona, total } (total = iglesias activas). Llena el selector "Distrito" del formulario del panel (value = id) y el filtro del sitio.
GET {{baseUrl}}/iglesias/distritos


### Iglesias · Crear iglesia
# DISTRITO o ADMIN (hoy abierto, ver api.md). Los campos del formulario "Agregar iglesia": nombre, comuna, distrito (el id del selector, ej. "araucania", o el nombre "Araucanía"; la lista sale de GET /iglesias/distritos), dirección, horario, pastor, correo, teléfono y la ubicación del mapa (lat y lng van juntas). Con los 5 datos la ficha queda "Completa". Guarda el _id en iglesiaId.
# @name crearIglesia
POST {{baseUrl}}/iglesias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Iglesia Bautista de Temuco",
  "comuna": "Temuco",
  "distrito": "araucania",
  "direccion": "Av. Alemania 0450, Temuco",
  "reuniones": "Domingo 11:00 · Miércoles 19:30",
  "encargado": "Pastor Juan Pérez",
  "email": "contacto@iglesiatemuco.cl",
  "telefono": "+56 45 221 3344",
  "lat": -38.7359,
  "lng": -72.5904
}


### Iglesias · Ver iglesia
# Público. Desactivada → 404 para visitantes.
GET {{baseUrl}}/iglesias/{{iglesiaId}}


### Iglesias · Editar iglesia
# DISTRITO o ADMIN. Solo cambia lo enviado.
PATCH {{baseUrl}}/iglesias/{{iglesiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reuniones": "Domingo 10:30"
}


### Iglesias · Completar ficha (teléfono)
# DISTRITO o ADMIN. Completa un dato faltante: la respuesta trae "pendientes" actualizado.
PATCH {{baseUrl}}/iglesias/{{iglesiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "telefono": "+56 9 1234 5678"
}


### Iglesias · Quitar ubicación
# Las dos coordenadas a la vez.
PATCH {{baseUrl}}/iglesias/{{iglesiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lat": null,
  "lng": null
}


### Iglesias · Desactivar iglesia
# Solo ADMIN. Borrado lógico.
DELETE {{baseUrl}}/iglesias/{{iglesiaId}}
Authorization: Bearer {{token}}


### Iglesias · Reactivar iglesia
# DISTRITO o ADMIN.
PATCH {{baseUrl}}/iglesias/{{iglesiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


######## USUARIOS ########

### Usuarios · Registrar usuario
# Público. Crea una cuenta con rol IGLESIA, que siempre tiene una iglesia asociada: "iglesia" es el _id de una iglesia activa (aquí, la creada en Iglesias → Crear iglesia). Guarda el _id del usuario en usuarioId.
# @name registrarUsuario
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "José",
  "last_name": "Muñoz",
  "email": "jose.munoz@iglesia.cl",
  "password": "secreto123",
  "iglesia": "{{iglesiaId}}"
}


### Usuarios · Listar usuarios
# Solo ADMIN.
GET {{baseUrl}}/auth
Authorization: Bearer {{token}}


### Usuarios · Ver usuario
# Solo ADMIN.
GET {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}


### Usuarios · Editar datos de usuario
# Solo ADMIN. Solo cambia los campos enviados; nombre y correo se guardan en minúsculas. Un correo ya usado por otro usuario responde 400.
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "José Luis",
  "email": "jose.luis@iglesia.cl"
}


### Usuarios · Asignar iglesia
# Solo ADMIN. Asigna o cambia la iglesia del usuario (debe existir y estar activa). { "iglesia": null } la quita, solo si el usuario no tiene rol IGLESIA.
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "iglesia": "{{iglesiaId}}"
}


### Usuarios · Asignar roles
# Solo ADMIN. Reemplaza todos los roles. Si el usuario queda con IGLESIA, debe tener una iglesia (si no, 400).
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roles": [
    "DISTRITO",
    "COMUNICACIONES"
  ]
}


### Usuarios · Cambiar contraseña
# Solo ADMIN.
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "nueva-clave-123"
}


### Usuarios · Desactivar usuario
# Solo ADMIN. Sus tokens dejan de servir al instante.
DELETE {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}


### Usuarios · Reactivar usuario
# Solo ADMIN.
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


### Usuarios · Desbloquear usuario
# Solo ADMIN. Desbloquea una cuenta bloqueada por 3 intentos fallidos (retry vuelve a 0).
PATCH {{baseUrl}}/auth/{{usuarioId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "unblock": true
}


######## ACTIVIDADES ########

### Actividades · Próximas (sitio)
# Vigentes desde la fecha (incluye las en curso), ordenadas por fecha. Usa la fecha de hoy.
GET {{baseUrl}}/actividades?desde=2026-10-01&limit=50


### Actividades · Solo nacionales
# Actividades sin distrito.
GET {{baseUrl}}/actividades?distrito=nacional


### Actividades · Rango de fechas
# Público. Con solo el día, hasta incluye todo ese día en hora de Chile.
GET {{baseUrl}}/actividades?desde=2026-10-01&hasta=2026-12-31


### Actividades · Listar desactivadas (panel)
# Con token de un rol que ve Actividades.
GET {{baseUrl}}/actividades?isActive=false
Authorization: Bearer {{token}}


### Actividades · Por completar (panel)
# Panel: actividades próximas sin descripción o lugar (el botón "Ir" del Por hacer). Sin token se ignora pendientes.
GET {{baseUrl}}/actividades?pendientes=true&desde=2026-10-01
Authorization: Bearer {{token}}


### Actividades · Crear actividad (varios días, con inscripción)
# COMUNICACIONES, DISTRITO o ADMIN. Fechas con zona horaria. Guarda el _id en actividadId.
# @name crearActividad
POST {{baseUrl}}/actividades
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Retiro de jóvenes",
  "descripcion": "Dos días de alabanza, enseñanza y convivencia para jóvenes de 15 a 30 años.",
  "fecha_inicio": "2026-10-24T09:00:00-03:00",
  "fecha_fin": "2026-10-25T18:00:00-03:00",
  "lugar": "Temuco",
  "distrito": "Araucanía",
  "inscripcion_url": "https://forms.gle/retiro2026",
  "inscritos": 35
}


### Actividades · Crear actividad nacional (un día)
# Sin distrito → "Nacional". Sin fecha_fin → el sitio muestra la hora.
POST {{baseUrl}}/actividades
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Reunión de la Junta de Pastores",
  "descripcion": "Reunión ordinaria. El enlace se envía por correo a los pastores.",
  "fecha_inicio": "2026-11-14T10:00:00-03:00",
  "lugar": "En línea"
}


### Actividades · Ver actividad
# Público.
GET {{baseUrl}}/actividades/{{actividadId}}


### Actividades · Editar actividad
# Solo cambia lo enviado.
PATCH {{baseUrl}}/actividades/{{actividadId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lugar": "Temuco, Camping Las Araucarias"
}


### Actividades · Quitar inscripción
# Quita el botón "Inscribirme".
PATCH {{baseUrl}}/actividades/{{actividadId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inscripcion_url": null
}


### Actividades · Cargar inscritos
# COMUNICACIONES, DISTRITO o ADMIN. El Resumen suma los inscritos de las próximas actividades.
PATCH {{baseUrl}}/actividades/{{actividadId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inscritos": 60
}


### Actividades · Desactivar actividad
# Solo ADMIN.
DELETE {{baseUrl}}/actividades/{{actividadId}}
Authorization: Bearer {{token}}


### Actividades · Reactivar actividad
# COMUNICACIONES, DISTRITO o ADMIN.
PATCH {{baseUrl}}/actividades/{{actividadId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


######## NOTICIAS ########

### Noticias · Listar (sitio)
# Sin token: solo publicadas, la más reciente primero. Sin el campo contenido.
GET {{baseUrl}}/noticias?limit=9


### Noticias · Filtrar por categoría
# Misiones, Comunicado oficial, Oración o Historia.
GET {{baseUrl}}/noticias?categoria=Misiones


### Noticias · Buscar por título
# Público. Sin distinguir tildes ni mayúsculas.
GET {{baseUrl}}/noticias?search=oracion


### Noticias · Borradores (panel)
# Con token de ADMIN o COMUNICACIONES.
GET {{baseUrl}}/noticias?publicado=false
Authorization: Bearer {{token}}


### Noticias · Desactivadas (panel)
# ADMIN o COMUNICACIONES: las desactivadas, para reactivarlas.
GET {{baseUrl}}/noticias?isActive=false
Authorization: Bearer {{token}}


### Noticias · Sin imagen (panel)
# ADMIN o COMUNICACIONES: noticias con "pendientes": ["imagen"].
GET {{baseUrl}}/noticias?pendientes=true
Authorization: Bearer {{token}}


### Noticias · Crear noticia publicada
# COMUNICACIONES o ADMIN. El autor sale del token. fecha_publicacion opcional (para noticias antiguas).
POST {{baseUrl}}/noticias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Congreso de Misiones 2026 reunió a iglesias de todo el país",
  "resumen": "Tres días de formación en Koyamentu con invitados de Brasil, México y Chile.",
  "contenido": "Entre el 13 y el 15 de marzo se realizó el Congreso de Misiones...",
  "categoria": "Misiones",
  "imagen": "https://cdn.iglesia.cl/noticias/congreso-misiones.jpg",
  "publicado": true,
  "fecha_publicacion": "2026-03-16T12:00:00-03:00"
}


### Noticias · Crear borrador
# Sin publicado → borrador. Guarda el _id en noticiaId.
# @name crearBorrador
POST {{baseUrl}}/noticias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Unánimes a una oración",
  "resumen": "Convocatoria nacional a un tiempo de oración por nuestras iglesias y por Chile.",
  "contenido": "Invitamos a todas las iglesias...",
  "categoria": "Oración"
}


### Noticias · Ver noticia
# Con contenido. Un borrador solo lo ve el panel (con token).
GET {{baseUrl}}/noticias/{{noticiaId}}
Authorization: Bearer {{token}}


### Noticias · Publicar borrador
# Si no tenía fecha_publicacion, queda la de ahora.
PATCH {{baseUrl}}/noticias/{{noticiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "publicado": true
}


### Noticias · Editar noticia
# Solo cambia lo enviado.
PATCH {{baseUrl}}/noticias/{{noticiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "resumen": "Convocatoria nacional a orar juntos el próximo domingo."
}


### Noticias · Desactivar noticia
# Solo ADMIN.
DELETE {{baseUrl}}/noticias/{{noticiaId}}
Authorization: Bearer {{token}}


### Noticias · Reactivar noticia
# COMUNICACIONES o ADMIN.
PATCH {{baseUrl}}/noticias/{{noticiaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


######## MENSAJES ########

### Mensajes · Enviar mensaje (sitio)
# Público, sin token: el formulario de contacto del sitio. Solo nombre, email y mensaje son obligatorios. Responde { message: "Mensaje recibido" }.
POST {{baseUrl}}/mensajes
Content-Type: application/json

{
  "nombre": "Rosa Pérez",
  "email": "rosa@correo.cl",
  "telefono": "+56 9 8765 4321",
  "asunto": "Horario",
  "mensaje": "¿A qué hora es el culto del domingo?"
}


### Mensajes · Listar todos
# Roles que ven Mensajes en el menú. El más nuevo primero. Guarda el _id del primero en mensajeId.
# @name listarMensajes
GET {{baseUrl}}/mensajes
Authorization: Bearer {{token}}


### Mensajes · Listar sin leer
# Los que cuentan en "Mensajes sin leer". Guarda el _id del primero en mensajeId.
GET {{baseUrl}}/mensajes?leido=false
Authorization: Bearer {{token}}


### Mensajes · Buscar
# Busca en nombre, correo y asunto.
GET {{baseUrl}}/mensajes?search=rosa
Authorization: Bearer {{token}}


### Mensajes · Ver mensaje
# Un mensaje (también archivado).
GET {{baseUrl}}/mensajes/{{mensajeId}}
Authorization: Bearer {{token}}


### Mensajes · Marcar leído
# Deja de contar en "sin leer". Lo normal es llamarlo al abrir el mensaje en el panel.
PATCH {{baseUrl}}/mensajes/{{mensajeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "leido": true
}


### Mensajes · Marcar como no leído
# Vuelve a contar como nuevo.
PATCH {{baseUrl}}/mensajes/{{mensajeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "leido": false
}


### Mensajes · Archivar mensaje
# Solo ADMIN. Borrado lógico.
DELETE {{baseUrl}}/mensajes/{{mensajeId}}
Authorization: Bearer {{token}}


### Mensajes · Listar archivados
# Los archivados.
GET {{baseUrl}}/mensajes?isActive=false
Authorization: Bearer {{token}}


### Mensajes · Recuperar mensaje
# Saca un mensaje del archivo.
PATCH {{baseUrl}}/mensajes/{{mensajeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


######## RESUMEN ########

### Resumen · Pantalla completa
# Cualquier usuario con sesión. Toda la pantalla Resumen: tarjetas (fichas, mensajes, actividades, noticias), Por hacer, accesos rápidos, actividad reciente y avance por distrito. Lo que el rol no ve llega en null.
GET {{baseUrl}}/resumen
Authorization: Bearer {{token}}


### Resumen · Por hacer
# Cualquier usuario con sesión. Las tarjetas del recuadro "Por hacer" según el rol: fichas de iglesia y actividades por completar, borradores de noticias.
GET {{baseUrl}}/resumen/por-hacer
Authorization: Bearer {{token}}


######## SALUD ########

### Salud · API arriba
# Responde "Hello World!".
GET {{baseUrl}}
